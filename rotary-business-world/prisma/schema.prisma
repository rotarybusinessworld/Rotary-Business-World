// Rotary Business World — data model
// Search note: `Business.searchVector` (tsvector), the GIN indexes, and the
// pg_trgm extension are added by a raw SQL migration (see prisma/sql/) because
// Postgres generated columns are not expressible in Prisma schema. Queries use
// $queryRaw through lib/search.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum Role {
  MEMBER
  CLUB_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BusinessStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Identity & membership
// ---------------------------------------------------------------------------

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  role           Role       @default(MEMBER)
  status         UserStatus @default(PENDING)
  hasPaid        Boolean    @default(false)
  emailVerifiedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // District this user is responsible for as an admin (null for MEMBER / SUPER_ADMIN).
  managedDistrictId String?
  managedDistrict   District? @relation("DistrictAdmins", fields: [managedDistrictId], references: [id])

  profile              Profile?
  rotaryInfo           RotaryInfo?
  businesses           Business[]
  verificationRequests VerificationRequest[] @relation("RequestUser")
  reviewedRequests     VerificationRequest[] @relation("ReviewerUser")
  emailTokens          EmailVerificationToken[]

  // Direct messaging (see Conversation / Message / Block below).
  conversationsAsP1 Conversation[] @relation("ConversationsAsP1")
  conversationsAsP2 Conversation[] @relation("ConversationsAsP2")
  messagesSent      Message[]      @relation("MessagesSent")
  blocksMade        Block[]        @relation("BlocksMade")
  blocksReceived    Block[]        @relation("BlocksReceived")

  // Payments + audit trail (see Payment / AuditLog below).
  payments  Payment[]
  auditLogs AuditLog[] @relation("AuditActor")

  // Business reviews written by this user.
  reviews Review[]

  @@index([status])
  @@index([managedDistrictId])
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  photoUrl  String?
  bio       String?
  phone     String?
  whatsapp  String?
  city      String?
  country   String?
  website   String?
  linkedin  String?
  instagram String?

  @@index([country, city])
}

model RotaryInfo {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotaryId       String?
  clubId         String?
  club           Club?     @relation(fields: [clubId], references: [id])
  districtId     String?
  district       District? @relation(fields: [districtId], references: [id])
  classification String?
  memberSince    Int?
  matchedRosterId String?
  matchedRoster  RosterMember? @relation(fields: [matchedRosterId], references: [id])

  @@unique([matchedRosterId]) // one verified account per roster identity (NULLs allowed)
  @@index([rotaryId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Rotary reference data (seeded via roster import)
// ---------------------------------------------------------------------------

model District {
  id      String  @id @default(cuid())
  code    String  @unique // e.g. "3201"
  name    String?
  country String?

  clubs        Club[]
  rotaryInfos  RotaryInfo[]
  rosterMembers RosterMember[]
  admins       User[]          @relation("DistrictAdmins")

  @@index([country])
}

model Club {
  id         String   @id @default(cuid())
  name       String
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  city       String?
  country    String?

  rotaryInfos   RotaryInfo[]
  rosterMembers RosterMember[]

  @@unique([name, districtId])
  @@index([country, city])
}

/// The authoritative global roster that signups are verified against.
model RosterMember {
  id           String    @id @default(cuid())
  rotaryId     String?
  fullName     String
  email        String?
  phone        String?
  clubName     String?
  districtCode String?
  clubId       String?
  club         Club?     @relation(fields: [clubId], references: [id])
  districtId   String?
  district     District?  @relation(fields: [districtId], references: [id])
  source       String    @default("import")
  importedAt   DateTime  @default(now())

  matchedInfos RotaryInfo[]

  @@index([rotaryId])
  @@index([email])
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ---------------------------------------------------------------------------
// Business directory
// ---------------------------------------------------------------------------

model Industry {
  id         String     @id @default(cuid())
  name       String     @unique
  slug       String     @unique
  categories Category[]
  businesses Business[]
}

model Category {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  industryId String
  industry   Industry   @relation(fields: [industryId], references: [id])
  businesses Business[]

  @@unique([name, industryId])
}

model Business {
  id          String         @id @default(cuid())
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  slug        String         @unique
  description String?
  logoUrl     String?
  coverUrl    String?
  industryId  String?
  industry    Industry?      @relation(fields: [industryId], references: [id])
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id])
  // Denormalized taxonomy text so the generated tsvector (raw SQL) can index it
  // without cross-table triggers. Kept in sync on every business write.
  industryName String?
  categoryName String?
  website     String?
  email       String?
  phone       String?
  whatsapp    String?
  addressLine String?
  city        String?
  country     String?
  lat         Float?
  lng         Float?
  linkedin    String?
  instagram   String?
  // Rotarian-member discount offered by this business
  discountPercent Int?
  discountNote    String?
  status      BusinessStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  images  BusinessImage[]
  reviews Review[]

  // searchVector and searchText are both GENERATED ALWAYS ... STORED columns
  // managed by prisma/sql/search.sql (npm run db:search). Declaring them here
  // as Unsupported prevents Prisma from touching or dropping them on migrate.
  // searchVector: weighted tsvector for full-text search (@@).
  // searchText:   concatenated plain text for trigram / word-similarity (<%  %).
  searchVector Unsupported("tsvector")?

  @@index([industryId])
  @@index([categoryId])
  @@index([country, city])
  @@index([status])
  @@index([searchVector], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model BusinessImage {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url        String
  sortOrder  Int      @default(0)

  @@index([businessId])
}

model VerificationRequest {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation("RequestUser", fields: [userId], references: [id], onDelete: Cascade)
  submittedInfo Json
  status        VerificationStatus @default(PENDING)
  reviewedById  String?
  reviewedBy    User?              @relation("ReviewerUser", fields: [reviewedById], references: [id])
  note          String?
  createdAt     DateTime           @default(now())
  reviewedAt    DateTime?

  @@index([status])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Direct messaging (member-to-member, 1:1)
//
// Isolated bounded context — see src/backend/messaging. 1:1 only: the two
// participants are stored in canonical order (participant1Id < participant2Id,
// enforced in code) so `@@unique([participant1Id, participant2Id])` dedups a
// pair and get-or-create is a single atomic upsert. Unread is derived, not
// stored: a conversation is unread for a participant when lastMessageAt is
// newer than their pXLastReadAt and the last message wasn't theirs.
// ---------------------------------------------------------------------------

model Conversation {
  id             String    @id @default(cuid())
  participant1Id String
  participant1   User      @relation("ConversationsAsP1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2Id String
  participant2   User      @relation("ConversationsAsP2", fields: [participant2Id], references: [id], onDelete: Cascade)
  // Per-participant read state.
  p1LastReadAt   DateTime?
  p2LastReadAt   DateTime?
  // Inbox sort key; bumped in the same transaction as each new message.
  lastMessageAt  DateTime  @default(now())
  messages       Message[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id, lastMessageAt])
  @@index([participant2Id, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ---------------------------------------------------------------------------
// Reviews (verified member → business, one review per member per business)
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  rating     Int      // 1–5
  body       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, reviewerId])
  @@index([businessId])
}

// ---------------------------------------------------------------------------
// Payments & audit trail
// ---------------------------------------------------------------------------

enum PaymentStatus {
  COMPLETED
  PENDING
  FAILED
}

enum PaymentSource {
  STRIPE
  DEMO
  RAZORPAY
}

/// One membership payment. The real audit trail behind `User.hasPaid`.
model Payment {
  id                      String        @id @default(cuid())
  userId                  String
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source                  PaymentSource @default(STRIPE)
  // Unique per Stripe checkout session — this is what makes the webhook and the
  // success page idempotent (nulls allowed for DEMO). A duplicate delivery upserts
  // to a no-op instead of creating a second row.
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?
  // Razorpay equivalents (unique so both the verify callback and the webhook dedup correctly)
  razorpayPaymentId       String?       @unique
  razorpayOrderId         String?
  amount                  Int           // minor units (paise or cents), from payment response
  currency                String        // ISO 4217, e.g. "INR" or "usd"
  status                  PaymentStatus @default(COMPLETED)
  paidAt                  DateTime      @default(now())
  createdAt               DateTime      @default(now())

  @@index([userId])
}

/// Append-only record of sensitive actions (money, verification, admin).
/// Never updated or deleted in code. `actorId` is nullable so system events (the
/// Stripe webhook) and history after a user is deleted both survive.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String // dotted verb, e.g. "payment.completed", "verification.approved"
  targetType String? // "User" | "Payment" | "VerificationRequest"
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
